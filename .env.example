# Cloth — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# Required: Serper.dev API key for Google Shopping search
# Get yours at https://serper.dev — free tier: 2,500 searches/month
SERPER_API_KEY=your_serper_api_key_here
# SERPAPI_KEY=  # legacy name, still accepted as fallback

# Optional: OpenAI API key for LLM query expansion and outfit generation
# Get yours at https://platform.openai.com/api-keys
# Leave blank to disable LLM features — app works fully without it
OPENAI_API_KEY=

# Optional: Skimlinks publisher ID for affiliate monetisation
# Sign up at https://skimlinks.com — free, no setup per retailer required
SKIMLINKS_PUB_ID=

# Optional: override the port the application listens on (default: 8000)
PORT=8000

# Optional: set to "production" to disable debug output
ENVIRONMENT=development
