# Cloth — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# Required: SerpAPI key for Google Shopping search
# Get yours at https://serpapi.com — free tier: 100 searches/month
SERPAPI_KEY=your_serpapi_key_here

# Optional: Anthropic API key for LLM query expansion (WN-042/WN-041)
# Get yours at https://console.anthropic.com
# Leave blank to disable LLM features — app works fully without it
ANTHROPIC_API_KEY=

# Optional: Fashn.ai API key for virtual try-on feature (WN-103/WN-105)
# Get yours at https://fashn.ai — free tier available
# Leave blank to disable the virtual try-on feature — app works fully without it
FASHN_API_KEY=

# Optional: override the port the application listens on (default: 8000)
PORT=8000

# Optional: set to "production" to disable debug output
ENVIRONMENT=development
